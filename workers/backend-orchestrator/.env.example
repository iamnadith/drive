# Backend Orchestrator build variables.
PANEL_URL=https://drive.example.com
BACKEND_ORCHESTRATOR_SECRET=replace-with-the-backend-orchestrator-secret-used-in-the-panel

# Cloudflare Git build configuration values (copy these into Build settings).
CLOUDFLARE_PROJECT_ROOT=workers/backend-orchestrator
CLOUDFLARE_BUILD_COMMAND=npm run build
CLOUDFLARE_DEPLOY_COMMAND=npm run deploy
