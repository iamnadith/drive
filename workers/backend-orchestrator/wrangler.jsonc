{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backend-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat_v2", "enable_ctx_exports"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
