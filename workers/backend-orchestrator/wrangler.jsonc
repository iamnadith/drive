{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backend-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
